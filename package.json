{
	"name": "lasuillard.github.io",
	"private": true,
	"readme": "./README.md",
	"author": {
		"name": "Yuchan Lee",
		"url": "https://github.com/lasuillard",
		"email": "lasuillard@gmail.com"
	},
	"scripts": {
		"postinstall": "svelte-kit sync",
		"dev": "vite dev --host",
		"build": "vite build",
		"build:watch": "vite build --watch",
		"preview": "vite preview",
		"preview:watch": "vite preview --watch",
		"fmt": "prettier --write --list-different .",
		"fmt:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest --run",
		"test:watch": "vitest --watch --ui",
		"e2e": "playwright test",
		"e2e:watch": "playwright test --ui"
	},
	"type": "module",
	"dependencies": {},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24",
			"onFail": "error"
		},
		"packageManager": {
			"name": "yarn",
			"version": ">=1,<2",
			"onFail": "error"
		}
	},
	"devDependencies": {
		"@codecov/vite-plugin": "1.9.1",
		"@playwright/test": "1.61.1",
		"@sentry/sveltekit": "10.66.0",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.1",
		"@sveltejs/vite-plugin-svelte": "5.1.1",
		"@tailwindcss/postcss": "4.3.3",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/svelte": "5.4.2",
		"@testing-library/user-event": "14.6.1",
		"@types/lodash": "4.17.24",
		"@types/qrcode": "1.5.6",
		"@vitest/coverage-v8": "3.2.7",
		"@vitest/ui": "3.2.7",
		"daisyui": "5.6.18",
		"date-fns": "4.4.0",
		"eslint": "9.39.5",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-jsdoc": "51.4.1",
		"eslint-plugin-svelte": "3.21.0",
		"glob": "11.1.0",
		"happy-dom": "18.0.1",
		"highlight.js": "11.11.1",
		"lodash": "4.18.1",
		"mermaid": "11.16.0",
		"minisearch": "7.2.0",
		"postcss": "8.5.20",
		"prettier": "3.9.5",
		"prettier-plugin-svelte": "3.5.2",
		"prettier-plugin-tailwindcss": "0.8.1",
		"qrcode": "1.5.4",
		"rehype-autolink-headings": "7.1.0",
		"rehype-highlight": "7.0.2",
		"rehype-mermaid": "3.0.0",
		"rehype-slug": "6.0.0",
		"rehype-stringify": "10.0.1",
		"remark-frontmatter": "5.0.0",
		"remark-gfm": "4.0.1",
		"remark-parse": "11.0.0",
		"remark-rehype": "11.1.2",
		"remark-stringify": "11.0.0",
		"svelte": "5.56.6",
		"svelte-check": "4.7.3",
		"svelte-persisted-store": "0.12.0",
		"tailwindcss": "4.3.3",
		"tslib": "2.8.1",
		"typescript": "5.9.3",
		"typescript-eslint": "8.64.0",
		"unified": "11.0.5",
		"unist-util-visit": "5.1.0",
		"vite": "6.4.3",
		"vitest": "3.2.7",
		"yaml": "2.9.0",
		"zod": "3.25.76"
	}
}
