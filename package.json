{
	"name": "lasuillard.github.io",
	"private": true,
	"readme": "./README.md",
	"author": {
		"name": "Yuchan Lee",
		"url": "https://github.com/lasuillard",
		"email": "lasuillard@gmail.com"
	},
	"scripts": {
		"postinstall": "patch-package && svelte-kit sync",
		"dev": "vite dev --host",
		"build": "vite build",
		"build:watch": "vite build --watch",
		"preview": "vite preview",
		"preview:watch": "vite preview --watch",
		"fmt": "prettier --write --list-different .",
		"fmt:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest --run",
		"test:watch": "vitest --watch --ui",
		"e2e": "./scripts/playwright-wrapper.sh test",
		"e2e:watch": "./scripts/playwright-wrapper.sh test --ui"
	},
	"type": "module",
	"dependencies": {},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24",
			"onFail": "error"
		},
		"packageManager": {
			"name": "yarn",
			"version": ">=1,<2",
			"onFail": "error"
		}
	},
	"devDependencies": {
		"@codecov/sveltekit-plugin": "2.0.1",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.62.1",
		"@sentry/sveltekit": "10.69.0",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.2",
		"@sveltejs/vite-plugin-svelte": "7.2.0",
		"@tailwindcss/postcss": "4.3.3",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/svelte": "5.4.2",
		"@testing-library/user-event": "14.6.1",
		"@types/lodash": "4.17.24",
		"@types/qrcode": "1.5.6",
		"@vitest/coverage-v8": "4.1.10",
		"@vitest/ui": "4.1.10",
		"daisyui": "5.7.9",
		"date-fns": "4.4.0",
		"eslint": "10.8.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-jsdoc": "63.3.2",
		"eslint-plugin-svelte": "3.22.0",
		"glob": "13.0.6",
		"happy-dom": "20.11.1",
		"highlight.js": "11.11.1",
		"lodash": "4.18.1",
		"mermaid": "11.16.0",
		"minisearch": "7.2.0",
		"patch-package": "^8.0.1",
		"postcss": "8.5.25",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"qrcode": "1.5.4",
		"rehype-autolink-headings": "7.1.0",
		"rehype-highlight": "7.0.2",
		"rehype-mermaid": "3.0.0",
		"rehype-slug": "6.0.0",
		"rehype-stringify": "10.0.1",
		"remark-frontmatter": "5.0.0",
		"remark-gfm": "4.0.1",
		"remark-parse": "11.0.0",
		"remark-rehype": "11.1.2",
		"remark-stringify": "11.0.0",
		"svelte": "5.56.8",
		"svelte-check": "4.7.4",
		"svelte-persisted-store": "0.12.0",
		"tailwindcss": "4.3.3",
		"tslib": "2.8.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.65.0",
		"unified": "11.0.5",
		"unist-util-visit": "5.1.0",
		"vite": "8.2.0",
		"vitest": "4.1.10",
		"yaml": "2.9.0",
		"zod": "4.4.3"
	}
}
