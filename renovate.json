{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>lasuillard/renovate-config"],
  "packageRules": [
    {
      "groupName": "Markdown pipeline",
      "groupSlug": "markdown-pipeline",
      "description": "Group Markdown processing dependencies",
      "matchDatasources": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "/unified/",
        "/^remark-/",
        "/^rehype-/",
        "unist-util-visit"
      ]
    },
    {
      "groupName": "Syntax highlighting",
      "groupSlug": "syntax-highlighting",
      "description": "Group syntax highlighting dependencies",
      "matchDatasources": ["npm"],
      "matchPackageNames": [
        "highlight.js",
        "highlightjs-svelte",
        "@taga3s/highlightjs-terraform"
      ],
      "matchUpdateTypes": ["minor", "patch"]
    }
  ]
}
