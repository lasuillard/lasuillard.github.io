{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>lasuillard/renovate-config"],
  "packageRules": [
    {
      "groupName": "Node Runtime (non-major)",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "matchPackageNames": ["!svelte", "!vite"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "Markdown pipeline",
      "description": "Group Markdown processing dependencies",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["/unified/", "/^remark-/", "/^rehype-/", "unist-util-visit"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "Syntax highlighting",
      "description": "Group syntax highlighting dependencies",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["highlight.js", "highlightjs-svelte", "@taga3s/highlightjs-terraform"],
      "matchUpdateTypes": ["minor", "patch"]
    }
  ]
}
